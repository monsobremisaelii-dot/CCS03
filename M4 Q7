#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

int main()
{
    
    double x1, x2, y1, y2, dx, dy, distance;
    int rounded;
    
    //Input
    
    cout << "Enter x1: ";
    cin >> x1;
    cout << "Enter y1: ";
    cin >> y1;
    
    cout << "Enter x2: ";
    cin >> x2;
    cout << "Enter y2: ";
    cin >> y2;
    
    //Process
    
    dx = x2 - x1;
    dy = y2 - y1;
    
    distance = sqrt(pow(dx,2) + pow(dy,2));
    rounded = round(distance);
    
    //Output
    
    cout << fixed << setprecision(3);
    cout << "\ndx: " << dx << endl;
    cout << "dy: " << dy << endl;
    cout << "Distance: " << distance << endl;
    cout << "Rounded Distance: " << rounded << endl;
    
    return 0;
}
